# Score library. The mobile JSON routes live under this origin.
EXPO_PUBLIC_API_BASE_URL=https://www.danijelbrecelj.com

# Relative MusicXML / MIDI / MP3 paths from the API are resolved against this CDN.
EXPO_PUBLIC_ASSET_BASE_URL=https://pub-208bb376563f4685a68fff6e640e1932.r2.dev

# RevenueCat public SDK keys. Create the app in RevenueCat, then paste the keys.
# Leave blank in development to see the paywall without a store product.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Entitlement unlocked by the one-time product. Create this entitlement in RevenueCat.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=play_piano_academy_pro

# Offering that contains the package. Leave blank to use the current offering.
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=

# App Store / Play product id. Non-consumable, one-time purchase.
EXPO_PUBLIC_REVENUECAT_PRODUCT_ID=play_piano_academy_pro
