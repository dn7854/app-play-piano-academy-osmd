{
  "expo": {
    "name": "D8R Piano Academy",
    "slug": "d8r-piano-academy",
    "owner": "danijelbrecelj",
    "scheme": "d8rpianoacademy",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0e141b",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e141b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danijelbrecelj.playpianoacademymobile",
      "buildNumber": "6",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "D8R Piano Academy listens for the notes you play on an acoustic piano so Wait to play can move ahead. The audio stays on this device.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.danijelbrecelj.playpianoacademymobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e141b"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-audio",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "D8R Piano Academy listens for the notes you play on an acoustic piano so Wait to play can move ahead. The audio stays on this device.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false,
          "androidFSTypes": [
            "mediaPlayback"
          ],
          "disableFFmpeg": true
        }
      ],
      "./plugins/withAndroidReleaseFixes"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1d6ce80-c702-438e-b6bf-36dd70fc7452"
      }
    }
  }
}
