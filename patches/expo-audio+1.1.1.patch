diff --git a/node_modules/expo-audio/ios/AudioSessionGuard.h b/node_modules/expo-audio/ios/AudioSessionGuard.h
new file mode 100644
index 0000000..adcb916
--- /dev/null
+++ b/node_modules/expo-audio/ios/AudioSessionGuard.h
@@ -0,0 +1,29 @@
+#import <AVFoundation/AVFoundation.h>
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+/// AVAudioSession raises NSException for illegal category/mode/option combinations.
+/// Swift `try` does not catch that, so these calls go through @try/@catch.
+///
+/// A BOOL method with a trailing NSError ** is imported as `throws` returning Void.
+/// The error parameter is removed:
+///   try AudioSessionGuard.setCategory(_:mode:options:)
+///   try AudioSessionGuard.setActive(_:options:)
+/// Returning NO with a nil error traps that bridge, so every failure writes an NSError.
+/// This header is compiled into the ExpoAudio module (podspec `source_files` includes
+/// `**/*.{h,m,swift}`), so Swift resolves AudioSessionGuard the same way as AudioTapProcessor.
+@interface AudioSessionGuard : NSObject
+
++ (BOOL)setCategory:(AVAudioSessionCategory)category
+               mode:(AVAudioSessionMode)mode
+            options:(AVAudioSessionCategoryOptions)options
+              error:(NSError *_Nullable *_Nullable)error;
+
++ (BOOL)setActive:(BOOL)active
+          options:(AVAudioSessionSetActiveOptions)options
+            error:(NSError *_Nullable *_Nullable)error;
+
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/node_modules/expo-audio/ios/AudioSessionGuard.m b/node_modules/expo-audio/ios/AudioSessionGuard.m
new file mode 100644
index 0000000..25c167f
--- /dev/null
+++ b/node_modules/expo-audio/ios/AudioSessionGuard.m
@@ -0,0 +1,64 @@
+#import "AudioSessionGuard.h"
+
+/// Swift imports BOOL + NSError ** as throws and traps if we return NO with a nil error.
+static void ExpoAudioFillError(NSError *__autoreleasing *error, NSString *message) {
+  if (error == nil || *error != nil) {
+    return;
+  }
+  *error = [NSError errorWithDomain:@"ExpoAudio"
+                               code:-1
+                           userInfo:@{
+                             NSLocalizedDescriptionKey : message ?: @"Audio session failed",
+                           }];
+}
+
+@implementation AudioSessionGuard
+
++ (BOOL)setCategory:(AVAudioSessionCategory)category
+               mode:(AVAudioSessionMode)mode
+            options:(AVAudioSessionCategoryOptions)options
+              error:(NSError **)error
+{
+  if (category == nil || mode == nil) {
+    ExpoAudioFillError(error, @"Invalid audio category or mode");
+    return NO;
+  }
+
+  BOOL didSet = NO;
+  @try {
+    didSet = [[AVAudioSession sharedInstance] setCategory:category
+                                                     mode:mode
+                                                  options:options
+                                                    error:error];
+  } @catch (NSException *exception) {
+    NSLog(@"[ExpoAudio] setCategory threw %@: %@", exception.name, exception.reason);
+    didSet = NO;
+    ExpoAudioFillError(error, exception.reason ?: exception.name ?: @"setCategory threw");
+  }
+
+  if (!didSet) {
+    ExpoAudioFillError(error, @"setCategory failed");
+  }
+  return didSet;
+}
+
++ (BOOL)setActive:(BOOL)active
+          options:(AVAudioSessionSetActiveOptions)options
+            error:(NSError **)error
+{
+  BOOL didSet = NO;
+  @try {
+    didSet = [[AVAudioSession sharedInstance] setActive:active withOptions:options error:error];
+  } @catch (NSException *exception) {
+    NSLog(@"[ExpoAudio] setActive threw %@: %@", exception.name, exception.reason);
+    didSet = NO;
+    ExpoAudioFillError(error, exception.reason ?: exception.name ?: @"setActive threw");
+  }
+
+  if (!didSet) {
+    ExpoAudioFillError(error, @"setActive failed");
+  }
+  return didSet;
+}
+
+@end
