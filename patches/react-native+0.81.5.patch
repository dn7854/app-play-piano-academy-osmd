+// Async void TurboModule calls run on the module queue. Turning an NSException
+// into a Hermes JSError there is a use-after-free (SIGSEGV). Record the
+// module, method, exception name and reason instead. The app reads this file.
+static void D8RAppendNativeDiagnostic(const char *moduleName, const char *methodName, NSString *exceptionName, NSString *reason)
+{
+  @try {
+    NSString *dir = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+    if (dir.length == 0) {
+      return;
+    }
+    NSISO8601DateFormatter *formatter = [NSISO8601DateFormatter new];
+    formatter.formatOptions = NSISO8601DateFormatWithInternetDateTime | NSISO8601DateFormatWithFractionalSeconds;
+    formatter.timeZone = [NSTimeZone timeZoneForSecondsFromGMT:0];
+    NSString *stamp = [formatter stringFromDate:[NSDate date]] ?: @"";
+    NSString *line = [NSString stringWithFormat:@"%@ [native] %s.%s %@ | %@\n",
+                                                stamp,
+                                                moduleName ?: "?",
+                                                methodName ?: "?",
+                                                exceptionName ?: @"NSException",
+                                                reason ?: @""];
+    NSString *path = [dir stringByAppendingPathComponent:@"d8r-diagnostics-native.log"];
+    static NSObject *lock;
+    static dispatch_once_t lockOnce;
+    dispatch_once(&lockOnce, ^{
+      lock = [NSObject new];
+    });
+    @synchronized(lock) {
+      NSFileManager *files = [NSFileManager defaultManager];
+      if ([files fileExistsAtPath:path]) {
+        NSDictionary *attrs = [files attributesOfItemAtPath:path error:nil];
+        unsigned long long size = [attrs fileSize];
+        if (size > 180000) {
+          NSData *all = [NSData dataWithContentsOfFile:path];
+          if (all.length > 90000) {
+            NSData *tail = [all subdataWithRange:NSMakeRange(all.length - 90000, 90000)];
+            [tail writeToFile:path atomically:YES];
+          }
+        }
+        NSFileHandle *handle = [NSFileHandle fileHandleForWritingAtPath:path];
+        [handle seekToEndOfFile];
+        [handle writeData:[line dataUsingEncoding:NSUTF8StringEncoding]];
+        [handle closeFile];
+      } else {
+        [files createFileAtPath:path contents:[line dataUsingEncoding:NSUTF8StringEncoding] attributes:nil];
+      }
+    }
+  } @catch (NSException *ignored) {
+  }
+}
